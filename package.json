{
  "name": "employee-manager-fe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "bun run build:app",
    "prebuild:app": "bun run codegen:graphql",
    "build:app": "tsc -b && vite build",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "eslint .",
    "preview": "vite preview",
    "msw:init": "msw init public",
    "clean": "bun scripts/clean.ts",
    "nuke": "bun scripts/nuke.ts",
    "codegen:graphql": "graphql-codegen --config codegen.ts"
  },
  "dependencies": {
    "@apollo/client": "^4.1.6",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.0.1",
    "@mui/x-data-grid": "^9.3.0",
    "@tanstack/react-router": "^1.170.8",
    "graphql": "^16.12.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "@graphql-codegen/cli": "^6.1.2",
    "@graphql-codegen/client-preset": "^5.2.3",
    "msw": "^2.14.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}